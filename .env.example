# Ad provider: 'admob' | 'unity' | 'mock'  (default: mock)
# Ignored when MEDIATION_ENABLED=true.
AD_PROVIDER=mock

# Enable waterfall mediation: AdMob (primary) → Unity (fallback).
# Set to true when running multiple networks. Overrides AD_PROVIDER.
MEDIATION_ENABLED=false

# ── Google AdMob ───────────────────────────────────────────────────────────────
# App IDs — added to AndroidManifest.xml / Info.plist by react-native-google-mobile-ads
ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx

# Banner ad unit IDs
ADMOB_BANNER_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
ADMOB_BANNER_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# Interstitial ad unit IDs
ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
ADMOB_INTERSTITIAL_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# Rewarded ad unit IDs
ADMOB_REWARDED_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
ADMOB_REWARDED_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# ── Unity Ads ─────────────────────────────────────────────────────────────────
# Single game ID covers both platforms in Unity Ads 4.x+
UNITY_GAME_ID=1234567

# Placement IDs — per platform (Unity Dashboard → Monetization → Placements)
# iOS placements
UNITY_BANNER_PLACEMENT_IOS=Banner_iOS
UNITY_INTERSTITIAL_PLACEMENT_IOS=Interstitial_iOS
UNITY_REWARDED_PLACEMENT_IOS=Rewarded_iOS
# Android placements
UNITY_BANNER_PLACEMENT_ANDROID=Banner_Android
UNITY_INTERSTITIAL_PLACEMENT_ANDROID=Interstitial_Android
UNITY_REWARDED_PLACEMENT_ANDROID=Rewarded_Android

# ── RevenueCat (In-App Purchases) ─────────────────────────────────────────────
# Provider: 'revenuecat' | 'mock'  (default: mock)
PURCHASE_PROVIDER=mock

# RevenueCat API keys (from RevenueCat dashboard → App Settings)
REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Entitlement identifier (from RevenueCat dashboard → Entitlements)
REVENUECAT_ENTITLEMENT_ID=premium

{
  "expo": {
    "name": "FocusBlock",
    "slug": "FocusBlock",
    "scheme": "focusblock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0d0b11"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ramseysmith.focusblock",
      "splash": {
        "image": "./assets/splash.png",
        "tabletImage": "./assets/splash-tablet.png",
        "resizeMode": "cover",
        "backgroundColor": "#0d0b11"
      },
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.ramseysmith.focusblock",
          "group.com.ramseysmith.focusblock"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0b11",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E8A87C",
          "sounds": [],
          "androidMode": "default"
        }
      ]
    ],
    "extra": {
      "adProvider": "mock",
      "mediationEnabled": false,
      "admobAndroidAppId": "ca-app-pub-3940256099942544~3347511713",
      "admobIosAppId": "ca-app-pub-3940256099942544~1458002511",
      "admobBannerAndroid": "",
      "admobBannerIos": "",
      "admobInterstitialAndroid": "",
      "admobInterstitialIos": "",
      "admobRewardedAndroid": "",
      "admobRewardedIos": "",
      "unityGameId": "",
      "unityBannerPlacementIos": "Banner_iOS",
      "unityBannerPlacementAndroid": "Banner_Android",
      "unityInterstitialPlacementIos": "Interstitial_iOS",
      "unityInterstitialPlacementAndroid": "Interstitial_Android",
      "unityRewardedPlacementIos": "Rewarded_iOS",
      "unityRewardedPlacementAndroid": "Rewarded_Android",
      "unityBannerPlacement": "Banner_Android",
      "unityInterstitialPlacement": "Interstitial_Android",
      "unityRewardedPlacement": "Rewarded_Android",
      "purchaseProvider": "mock",
      "revenueCatIosKey": "",
      "revenueCatAndroidKey": "",
      "revenueCatEntitlementId": "premium",
      "router": {},
      "eas": {
        "projectId": "6c28a2bf-1a6f-4e4e-b392-a223f1360bd3"
      }
    }
  }
}
